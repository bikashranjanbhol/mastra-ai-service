# ─────────────────────────────────────────────────────────────────────────────
# mastra-ai-service — example environment
#
# Copy to `.env` and fill in whichever providers you actually have keys for:
#     cp .env.example .env
#
# `.env` is gitignored. NEVER commit real keys.
#
# You do NOT need every provider. The app inspects these at startup and simply
# SKIPS providers whose key is absent (logging one line each). It hard-fails
# only if ZERO providers are configured.
# ─────────────────────────────────────────────────────────────────────────────

# ── Model providers ──────────────────────────────────────────────────────────
# Env var names below are verified against @mastra/core's provider-registry.json
# (v1.57.0) — these are the exact names Mastra's model router reads.

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
# Mastra accepts EITHER of these two names; GOOGLE_GENERATIVE_AI_API_KEY wins
# if both are set. Setting just one is enough.
GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_API_KEY=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Mistral — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# OpenRouter (gateway; one key fronts many vendors) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Default model selection ──────────────────────────────────────────────────
# Which provider/tier the agents use when the request doesn't specify one.
# DEFAULT_PROVIDER must be one of: openai | anthropic | google | groq | mistral | openrouter
# DEFAULT_TIER must be one of: fast | flagship | reasoning
# If DEFAULT_PROVIDER is unset or its key is missing, the app picks the first
# configured provider in preference order instead of crashing.
DEFAULT_PROVIDER=
DEFAULT_TIER=fast

# Comma-separated provider order for the fallback chain. Providers without a
# key are dropped from the chain automatically. Leave blank for the built-in order.
FALLBACK_PROVIDERS=

# ── Storage ──────────────────────────────────────────────────────────────────
# Local default is a SQLite file (file:./mastra.db) — no config needed.
# Set DATABASE_URL to a postgres:// or postgresql:// URL to switch to Postgres.
# This is the ONLY switch; no agent or tool code changes.
DATABASE_URL=

# Optional: hosted LibSQL / Turso instead of a local file.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# ── Observability ────────────────────────────────────────────────────────────
# error | warn | info | debug
LOG_LEVEL=info
SERVICE_NAME=mastra-ai-service

# ── Benchmark harness (npm run bench) ────────────────────────────────────────
# Max providers exercised concurrently.
BENCH_CONCURRENCY=3
# Retry budget per task on 429 / 5xx before it is marked failed.
BENCH_MAX_RETRIES=3
# Which tier the benchmark exercises across every configured provider.
BENCH_TIER=fast
# Where timestamped result JSON is written.
BENCH_OUT_DIR=./bench-results
# Optional path to a JSON file of per-model token rates for the est. cost column.
# See src/mastra/config/pricing.ts for the expected shape. Without it, cost
# prints as "n/a" rather than a made-up number.
MODEL_PRICING_FILE=

# ── Misc ─────────────────────────────────────────────────────────────────────
# Silences Mastra CLI analytics (useful on locked-down networks).
MASTRA_TELEMETRY_DISABLED=1
